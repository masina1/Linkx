{
  "manifest_version": 3,
  "name": "Linkx",
  "version": "1.2.1",
  "description": "Open your chosen links for today in one click. Switch color-coded profiles (work, gaming, and more), each with its own links.",
  "permissions": ["bookmarks", "storage", "tabs", "alarms", "contextMenus"],
  "action": {
    "default_title": "Linkx — open today's links",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
